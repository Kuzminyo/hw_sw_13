# generate with: python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=

# Postgres (if POSTGRES_DB is empty, SQLite is used)
POSTGRES_DB=quotes
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# MongoDB from homework #9 (for `manage.py migrate_from_mongo`)
MONGO_URI=mongodb://localhost:27017
MONGO_DB=quotes_db

# Email for password reset.
# Mailpit from docker-compose catches all emails: http://localhost:8026
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1026
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=False
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=Quotes to Scrape <noreply@quotes.local>
# Real mailbox, e.g. Gmail: EMAIL_HOST=smtp.gmail.com, EMAIL_PORT=587, EMAIL_USE_TLS=True,
# EMAIL_HOST_USER=<address>, EMAIL_HOST_PASSWORD=<app password>
# Without SMTP: EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend (prints to terminal)

# reset link lifetime, seconds
PASSWORD_RESET_TIMEOUT=3600