# ---------- PostgreSQL ----------
POSTGRES_DB=contacts_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change_me
POSTGRES_PORT=5435
# used when the app runs outside Docker
DATABASE_URL=postgresql+psycopg2://postgres:change_me@localhost:5435/contacts_db

# ---------- JWT ----------
# generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change_me_to_a_long_random_string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
EMAIL_TOKEN_EXPIRE_HOURS=24
RESET_TOKEN_EXPIRE_MINUTES=30

# ---------- Redis (user cache + rate limiter storage) ----------
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_PASSWORD=change_me
USER_CACHE_TTL_SECONDS=900

# ---------- Rate limits ----------
RATE_LIMIT_CONTACTS=30/minute
RATE_LIMIT_CREATE_CONTACT=5/minute

# ---------- CORS (comma separated) ----------
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500

# ---------- Email (SMTP) ----------
# Default: Mailpit from docker-compose, open http://localhost:8025 to read emails.
# For a real mailbox, e.g. Gmail: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=465,
# MAIL_SSL_TLS=True, MAIL_USERNAME/MAIL_PASSWORD = address + app password,
# and set MAIL_SERVER_IN_DOCKER / MAIL_PORT_IN_DOCKER to the same values.
MAIL_SERVER=localhost
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@contacts.local
MAIL_FROM_NAME=Contacts API
MAIL_STARTTLS=False
MAIL_SSL_TLS=False

# ---------- Cloudinary (https://console.cloudinary.com -> API Keys) ----------
CLOUDINARY_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

APP_PORT=8013